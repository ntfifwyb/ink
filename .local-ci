#!/usr/bin/env bash
# The checks every PR must pass, run on this machine by `local-ci` (claude-toolkit)
# in place of GitHub Actions. Run it directly to check without posting a status.
# ruff runs through uvx, pinned so results don't drift between runs.
set -euo pipefail
cd "$(dirname "$0")"
ruff="uvx ruff@0.14.0"

step() { echo; echo "== $*"; }

step "no emoji";     python3 scripts/check_no_emoji.py
step "format";       $ruff format --check .
step "lint";         $ruff check .
step "test";         python3 -m unittest discover -s tests -v
step "build";        python3 scripts/build.py
